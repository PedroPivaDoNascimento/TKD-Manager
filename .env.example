# Conexao PostgreSQL (docker compose dev: docker compose up -d postgres)
DATABASE_URL=postgresql://tkd:tkd_secret@localhost:5432/tkd_manager?schema=public

# Segredo usado para assinar o JWT de sessao do Professor (OBRIGATORIO trocar!)
JWT_SECRET=troque-este-segredo-em-producao

# Senha padrao do usuario Professor criado pelo seed (professor@miguettiteam.com)
SEED_DEFAULT_PASSWORD=miguetti123
